<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Valheim mods target .NET Framework 4.8 (same as the game) -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Bragi</AssemblyName>
    <RootNamespace>Bragi</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- r2modman Default profile — BepInEx lives here -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default</ValheimDir>
    <!-- Override BepInExDir/ManagedDir individually if your layout differs -->
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimDir)\BepInEx</BepInExDir>
    <!-- Game managed DLLs live in the Steam install, NOT the r2modman profile -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">D:\SteamLibrary\steamapps\common\Valheim\valheim_Data\Managed</ManagedDir>
  </PropertyGroup>

  <!-- Post-build: copy .dll to BepInEx plugins folder for quick testing -->
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <MakeDir Directories="$(BepInExDir)\plugins\Bragi\resources" />
    <MakeDir Directories="$(BepInExDir)\config\Bragi\Localization" />
    <Copy SourceFiles="$(OutputPath)\Bragi.dll"
          DestinationFolder="$(BepInExDir)\plugins\Bragi\" />
    <!-- Copy song JSONs -->
    <Copy SourceFiles="@(SongFiles)"
          DestinationFolder="$(BepInExDir)\config\Bragi\songs\" />
    <!-- Copy localization -->
    <Copy SourceFiles="Localization\English.json"
          DestinationFolder="$(BepInExDir)\config\Bragi\Localization\" />
    <Message Text="✅ Bragi deployed to BepInEx plugins" Importance="high" />
  </Target>

  <ItemGroup Label="SongFiles">
    <SongFiles Include="..\..\songs\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the localization file into the DLL so it's always available -->
    <EmbeddedResource Include="Localization\English.json">
      <LogicalName>Bragi.Localization.English.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ======= BepInEx & Jotunn via NuGet (when BepInEx not locally installed) ======= -->
  <ItemGroup Condition="!Exists('$(BepInExDir)')">
    <!-- BepInEx feed: https://nuget.bepinex.dev/v3/index.json -->
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <!-- Jotunn is published to nuget.org as JotunnLib -->
    <PackageReference Include="JotunnLib" Version="2.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- ======= BepInEx & Jotunn (Local Override) ======= -->
  <ItemGroup Condition="Exists('$(BepInExDir)')">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HarmonyX">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jotunn">
      <!-- r2modman installs Jotunn under ValheimModding-Jotunn; plain installs use just Jotunn -->
      <HintPath>$(BepInExDir)\plugins\ValheimModding-Jotunn\Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ======= Unity & Valheim Game DLLs (Local Override) ======= -->
  <ItemGroup Condition="Exists('$(ManagedDir)')">
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Input system (legacy Input class) -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityWebRequest audio (UnityWebRequestMultimedia, DownloadHandlerAudioClip) -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- IMGUI text rendering (FontStyle, TextAnchor) -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
