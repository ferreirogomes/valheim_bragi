## Bragi Valheim Mod — .gitignore

# Build artifacts
bin/
obj/
*.user
*.suo
.vs/

# BepInEx (don't commit game DLLs)
src/BragiPlugin/libs/
*.dll

# Unity
unity/BragiAssets/Library/
unity/BragiAssets/Temp/
unity/BragiAssets/Logs/
unity/BragiAssets/*.csproj

# Generated AssetBundle (rebuild from Unity)
resources/bragiassets.bundle

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.sln.DotSettings.user

# Audio files (too large for git — distribute via release ZIP)
songs/*.ogg
songs/*.wav
!songs/*.json
